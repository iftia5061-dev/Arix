rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function nonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function hasPublishedContent(data) {
      return data.status == 'published'
        && data.visibility == 'public'
        && data.keys().hasAll(['name', 'slug', 'productType', 'platforms', 'shortDescription', 'description', 'coverImage', 'features', 'links'])
        && nonEmptyString(data.name)
        && nonEmptyString(data.slug)
        && nonEmptyString(data.shortDescription)
        && nonEmptyString(data.description)
        && nonEmptyString(data.coverImage)
        && data.platforms is list && data.platforms.size() > 0
        && data.features is list && data.features.size() > 0
        && data.links is map
        // Web, Website and SaaS products need a live demo. Software, tools
        // and apps use their screenshots, so an empty demo URL is valid.
        && ((data.category == 'web-design' || data.category == 'saas'
          || data.platforms.hasAny(['Web', 'web', 'Website', 'website', 'Browser', 'browser']))
          ? nonEmptyString(data.links.demoUrl)
          : true);
    }

    function validPublicProduct(data) {
      return hasPublishedContent(data)
        && (
          (data.productType == 'showcase'
            && !data.keys().hasAny(['pricing', 'gumroad'])
            && !data.links.keys().hasAny(['checkoutUrl']))
          || (data.productType == 'sale'
            && data.keys().hasAll(['pricing'])
            && data.pricing is map
            && data.pricing.amount is int && data.pricing.amount > 0
            && nonEmptyString(data.pricing.currency)
            && (data.pricing.type == 'one-time' || data.pricing.type == 'subscription' || data.pricing.type == 'lifetime')
            && nonEmptyString(data.links.checkoutUrl))
        );
    }

    match /products/{productId} {
      allow get, list: if resource.data.visibility == 'public' || isAdmin();
      allow create, update: if isAdmin()
        && (request.resource.data.visibility != 'public' || validPublicProduct(request.resource.data));
      allow delete: if isAdmin();
    }

    // Create this document manually in Firebase Console for each administrator:
    // admins/{Firebase Auth UID}  { role: 'admin' }
    match /admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get, create, update, delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
