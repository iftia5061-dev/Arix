rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Release files must stay private. The Functions Admin SDK generates a
    // 15-minute signed URL only after it confirms a paid order belongs to the
    // signed-in customer.
    match /releases/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
